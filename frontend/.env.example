# Copy to .env.local for local development. On Vercel, set these under Project Settings > Environment Variables.

# URL of the Spring Boot API with no trailing slash.
VITE_API_URL=http://localhost:8080

# Photo upload (Cloudinary). Leave both empty to fall back to a plain "photo link" field.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
